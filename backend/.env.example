# ---------------------------------------------------------------------------
# LLM provider selection: "groq" or "gemini" (auto-detected if left blank)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq - free API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini - free API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local embedding model (no API key required, ~90MB download on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval / chunking tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
LLM_TEMPERATURE=0.2

# Comma separated list of allowed browser origins (Vercel URL goes here)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
